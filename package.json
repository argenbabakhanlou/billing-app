{
  "name": "billing-app",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic service layer for MCA daily billing",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "simulate": "tsx --env-file=.env scripts/simulate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
